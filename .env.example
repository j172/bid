MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=false
ADMIN_EMAIL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_AUDIENCE_ID=

# Optional overrides for passkey/WebAuthn RP config (see lib/webauthn.ts's
# resolveWebauthnRp) — leave blank to use the NODE_ENV-based defaults
# (production: j172.tw / https://j172.tw, otherwise: localhost / http://localhost:3000).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Optional override for this site's public origin (see lib/siteUrl.ts's
# resolveSiteUrl) — used to build sitemap.xml/robots.txt/canonical/hreflang/
# Open Graph/JSON-LD/llms.txt URLs. Leave blank to use the production
# default (https://bid.j172.tw).
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile anti-abuse widget for the public /contact form (issue
# #104) and, since issue #140 H-1, the login page's password and TOTP steps
# as well — one shared key pair, no separate widget. SITE_KEY is not secret
# and is read server-side in app/[locale]/contact/page.tsx and
# app/[locale]/login/page.tsx then passed to the client forms; SECRET_KEY is
# used only server-side (see lib/turnstile.ts) to verify submitted tokens via
# Cloudflare's siteverify endpoint.
CLOUDFLARE_TURNSTILE_SITE_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=

# Cloudflare Workers AI (issue #240) — generic Traditional Chinese
# translation client (see lib/translate.ts). A SEPARATE Cloudflare credential
# pair from CLOUDFLARE_TURNSTILE_* above (Turnstile only verifies anti-abuse
# tokens, it can't call Workers AI) — create an API token scoped to
# "Workers AI: Edit" under the Cloudflare dashboard for this account.
# Originally consumed by the herbots.be news auto-import pipeline (removed in
# issue #280); lib/translate.ts itself is kept as a reusable utility and
# currently has no caller in this codebase.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_API_TOKEN=

# Recipient of the /contact form's admin notification (see lib/notifications.ts's
# resolveContactAdminEmail). This is the receiving end, not the support address
# shown to visitors (that lives in messages/*.json). Leave blank to default to
# service@xiangshuicn.cc, or set a custom address here so changes never need
# a code edit or redeploy.
CONTACT_ADMIN_EMAIL=

# LINE Login v2.1 (issue #360) — OAuth 2.0 / OpenID Connect login & registration.
# Create a "LINE Login" Channel in LINE Developers Console (https://developers.line.biz).
# Set Callback URL in LINE Console: https://<your-domain>/api/auth/line/callback
# (for local dev: http://localhost:3000/api/auth/line/callback).
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
# Optional override for the redirect callback URL. Defaults to ${NEXT_PUBLIC_SITE_URL}/api/auth/line/callback
LINE_CALLBACK_URL=
