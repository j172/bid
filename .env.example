MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
MYSQL_SSL=false
ADMIN_EMAIL=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_AUDIENCE_ID=

# Optional overrides for passkey/WebAuthn RP config (see lib/webauthn.ts's
# resolveWebauthnRp) — leave blank to use the NODE_ENV-based defaults
# (production: j172.tw / https://j172.tw, otherwise: localhost / http://localhost:3000).
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# Optional override for this site's public origin (see lib/siteUrl.ts's
# resolveSiteUrl) — used to build sitemap.xml/robots.txt/canonical/hreflang/
# Open Graph/JSON-LD/llms.txt URLs. Leave blank to use the production
# default (https://bid.j172.tw).
NEXT_PUBLIC_SITE_URL=
